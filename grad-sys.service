[Unit]
Description=Graduation Project Practice Management System (FastAPI + SQLite + Vue3)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/grad-sys
ExecStart=/root/grad-sys/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8090 --workers 1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
